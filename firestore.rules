rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Replace these five example values with the same actual Google emails
    // used in firebase-config.js BEFORE deployment. Never make this public!
    function owner() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email == 'OWNER_EMAIL_HERE';
    }
    function family() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'DAD_EMAIL_HERE','MOM_EMAIL_HERE','SISTER_EMAIL_HERE','OWNER_EMAIL_HERE'
        ];
    }
    match /trips/fukuoka2026/shared/plan {
      allow read: if family();
      allow write: if owner();
    }
    match /trips/fukuoka2026/shared/checks {
      allow read, write: if family();
    }
    match /trips/fukuoka2026/shared/quest {
      allow read, write: if family();
    }
    match /trips/fukuoka2026/profiles/{email} {
      allow read: if family();
      allow write: if family() && request.auth.token.email == email;
    }
    match /trips/fukuoka2026/private/{email} {
      allow read, write: if family() && request.auth.token.email == email;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
